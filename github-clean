#!/bin/sh

if [ -z "${GITHUB_TOKEN}" ] ; then
    echo "'GITHUB_TOKEN' is not set" >&2
    exit 1
fi

{ 
    gh api repos/cyd01/gorp/actions/runs | jq -r '.workflow_runs[] | select(.head_branch != "main") | "\(.id)"' | sed 's#^#gh api repos/cyd01/gorp/actions/runs/#' | sed 's/$/ -X DELETE/'
    gh api repos/cyd01/gorp/actions/runs | jq -r '.workflow_runs[] | select(.head_branch == "main" and .name == "pages build and deployment") | "\(.id)"' | sed 's#^#gh api repos/cyd01/gorp/actions/runs/#' | sed 's/$/ -X DELETE/'
} | sed '1d' | sh

gh api repos/cyd01/gorp/deployments | jq -r '.[]|.id' | sed 's#^#gh api repos/cyd01/gorp/deployments/#' | sed 's/$/ -X DELETE/' | sed '1d' | sh
